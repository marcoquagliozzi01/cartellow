# ===== Produzione =====
# Copia in .env.prod sul server e compila TUTTI i valori. Non committare mai .env.prod.

# Dominio pubblico (Caddy ottiene il certificato HTTPS in automatico).
# Per provare senza dominio puoi mettere "localhost" (certificato locale non fidato).
APP_DOMAIN=cartellow.example.com
ACME_EMAIL=tu@example.com
APP_URL=https://cartellow.example.com

# Genera con: docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=

DB_DATABASE=cartellow
DB_USERNAME=cartellow
DB_PASSWORD=CAMBIAMI_con_una_password_lunga_e_casuale

# Email (SMTP reale: es. Brevo, Mailjet, Resend, Gmail SMTP... verifica i limiti gratuiti)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ordini@example.com

# Backup
BACKUP_KEEP_DAYS=14
