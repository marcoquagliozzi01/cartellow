# ===== Sviluppo locale =====
# Copiato in .env da `make init` (HOST_UID/HOST_GID vengono impostati in automatico)
HOST_UID=1000
HOST_GID=1000

# Porta su cui apri l'app: http://localhost:8080
APP_PORT=8080

# Database (solo locale: in produzione usa .env.prod con password vere)
DB_DATABASE=cartellow
DB_USERNAME=cartellow
DB_PASSWORD=cartellow_dev_password
# Porta esposta sull'host (solo 127.0.0.1) per usare un client DB, es. DBeaver
DB_PORT_HOST=5432
